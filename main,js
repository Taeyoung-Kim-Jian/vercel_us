window.addEventListener('DOMContentLoaded', async () => {
  // === 0) Supabase 연결 ===
  const SUPABASE_URL = 'https://sssmldmhcfuodutvvcqf.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNzc21sZG1oY2Z1b2R1dHZ2Y3FmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTk1MDc2MjUsImV4cCI6MjA3NTA4MzYyNX0.zxw9Hr9Mz9fuV9VIpFcISe-62kary1WABTrOnYZiIN4';

  // ✅ Supabase SDK에서 createClient 함수 가져오기
  const { createClient } = window.supabase;
  const db = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  // === 1) DOM 요소 ===
  const tbody = document.getElementById('total-table-body');
  const loadMoreBtn = document.getElementById('loadMoreBtn');

  // === 2) 전역 상태 ===
  let allData = [];
  let showing = 5; // 기본 5개만 표시

  // === 3) 데이터 불러오기 ===
  async function loadTotalReturn() {
    tbody.innerHTML = `<tr><td colspan="4">⏳ 데이터를 불러오는 중...</td></tr>`;

    try {
      // Supabase에서 total_return 테이블 읽기
      const { data, error } = await db
        .from('total_return')
        .select('*')
        .order('수익률', { ascending: false });

      if (error) throw error;
      if (!data || data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4">데이터가 없습니다.</td></tr>`;
        return;
      }

      allData = data;
      renderTable();
    } catch (err) {
      console.error('❌ Supabase Error:', err);
      tbody.innerHTML = `<tr><td colspan="4">❌ 데이터 불러오기 실패 (${err.message})</td></tr>`;
    }
  }

  // === 4) 테이블 렌더링 ===
  function renderTable() {
    tbody.innerHTML = '';

    allData.slice(0, showing).forEach(row => {
      const tr = document.createElement('tr');
      const rate = parseFloat(row.수익률 ?? 0);
      tr.innerHTML = `
        <td>${row.종목명 || '-'}</td>
        <td>${row.매수가?.toLocaleString() || '-'}</td>
        <td>${row.현재가?.toLocaleString() || '-'}</td>
        <td style="color:${rate >= 0 ? '#d32f2f' : '#1976d2'};">
          ${rate >= 0 ? '▲' : '▼'}${rate.toFixed(2)}%
        </td>
      `;
      tbody.appendChild(tr);
    });

    // 더보기 버튼 표시
    if (allData.length > 5) {
      loadMoreBtn.style.display = 'inline-block';
      loadMoreBtn.textContent = showing > 5 ? '접기' : '더보기';
    } else {
      loadMoreBtn.style.display = 'none';
    }
  }

  // === 5) 더보기 버튼 ===
  loadMoreBtn.addEventListener('click', () => {
    showing = showing === 5 ? allData.length : 5;
    renderTable();
  });

  // === 6) 실행 ===
  loadTotalReturn();
});
